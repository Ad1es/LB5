<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:HourseLB3.Models"
             x:Class="HourseLB3.ListBuildingsPage" 
             Title="Список домов">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Выйти" 
                     Clicked="OnLogoutClicked" 
                     Priority="0" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Padding="10">

        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="5" Margin="0,0,0,10">
            <SearchBar x:Name="SearchBar" 
                       Placeholder="Поиск..." 
                       TextChanged="OnFilterChanged" />
            <Button Grid.Column="1" 
                    Text="Сброс" 
                    Clicked="OnResetClicked" 
                    BackgroundColor="#e74c3c" 
                    TextColor="White" />
        </Grid>

        <HorizontalStackLayout Grid.Row="1" Spacing="10" Margin="0,0,0,10">
            <Picker x:Name="MatPicker" 
                    Title="Материал" 
                    WidthRequest="150" 
                    SelectedIndexChanged="OnFilterChanged" />
            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                <CheckBox x:Name="LiftCheck" 
                          CheckedChanged="OnFilterChanged" />
                <Label Text="Лифт" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="2" Spacing="10" Margin="0,0,0,10">
            <Button Text="Отчет (Список)" 
                    Clicked="OnListReport" 
                    BackgroundColor="#3498db" 
                    TextColor="White" />
            <Button Text="Статистика" 
                    Clicked="OnStatsReport" 
                    BackgroundColor="#9b59b6" 
                    TextColor="White" />
        </HorizontalStackLayout>

        <CollectionView x:Name="ListCol" Grid.Row="3">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ResidentialBuilding">
                    <Frame Margin="0,5" Padding="10" BorderColor="#D0D0D0">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Image Source="{Binding ImagePath}" 
                                   WidthRequest="50" 
                                   HeightRequest="50" 
                                   Aspect="AspectFill" />

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0">
                                <Label Text="{Binding Address}" 
                                       FontAttributes="Bold" 
                                       FontSize="16" />
                                <Label Text="{Binding Material}" 
                                       FontSize="12" 
                                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <Button Grid.Column="2" 
                                    Text="✎" 
                                    Clicked="OnEdit" 
                                    CommandParameter="{Binding .}" 
                                    BackgroundColor="#f1c40f" 
                                    TextColor="Black" 
                                    WidthRequest="45" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="4" 
                Text="Добавить новый адрес" 
                Clicked="OnAdd" 
                Margin="0,10,0,0" 
                BackgroundColor="#2ecc71" 
                TextColor="White" 
                FontAttributes="Bold" />
    </Grid>
</ContentPage>
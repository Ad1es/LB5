<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HourseLB3.RegistrationPage" Title="Регистрация">
    <VerticalStackLayout Padding="30" Spacing="15">
        <Entry x:Name="RegUser" Placeholder="Логин" />
        <Entry x:Name="RegEmail" Placeholder="Email" Keyboard="Email" />
        <Entry x:Name="RegPass" Placeholder="Пароль" IsPassword="True" />
        <Button Text="Зарегестрировать" Clicked="OnRegisterClicked" BackgroundColor="Green" />
    </VerticalStackLayout>
</ContentPage>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HourseLB3.LoginPage" Title="Вход">
    <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center">
        <Entry x:Name="UserEntry" Placeholder="Логин" />
        <Entry x:Name="PassEntry" Placeholder="Пароль" IsPassword="True" />
        <Button Text="Войти" Clicked="OnLoginClicked" />
        <Button Text="Регистрация" Clicked="OnRegClicked" BackgroundColor="Transparent" TextColor="Gray" />
    </VerticalStackLayout>
</ContentPage>